# EditorConfig is awesome: https://EditorConfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

[*.{php,java,sql}]
indent_style = space
indent_size = 4

[*.{js,html,css,json,md,yml,yaml}]
indent_style = space
indent_size = 2

